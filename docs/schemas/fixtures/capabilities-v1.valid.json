{
  "baseline_schema_version": 1,
  "capability_schema_version": 1,
  "checker_schema_version": 2,
  "engine_version": "0.4.0",
  "explanation_schema_version": 1,
  "formats": [
    "text",
    "json",
    "concise"
  ],
  "inspection_schema_version": 0,
  "limits": {
    "baseline_bytes": 16777216,
    "baseline_entries": 100000,
    "config_bytes": 65536,
    "explanation_bytes_per_finding": 8192,
    "max_discovery_entries": 100000,
    "max_directory_entries": 20000,
    "max_discovery_depth": 256,
    "max_input_files": 10000,
    "max_source_bytes": 1000000,
    "related_sites_per_finding": 32,
    "report_bytes": 33554432,
    "source_snippet_bytes_per_finding": 2048
  },
  "python_targets": [
    "3.11",
    "3.12",
    "3.13"
  ],
  "rules": [
    {
      "code": "TP1001",
      "enabled_by_default": true,
      "explanation_id": "TP1001.R001",
      "semantic_version": 1,
      "tier": "stable"
    },
