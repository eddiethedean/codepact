+thread_local! {
+    static G4_TIMES: std::cell::RefCell<Option<Vec<std::time::Instant>>> = const { std::cell::RefCell::new(None) };
+}
+pub static G4_SKIP_FILTER: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+pub fn g4_start() {
+    G4_TIMES.with(|v| *v.borrow_mut() = Some(Vec::with_capacity(7)));
+    g4_mark();
+}
+pub fn g4_mark() {
+    G4_TIMES.with(|v| { if let Some(times) = v.borrow_mut().as_mut() { times.push(std::time::Instant::now()); } });
+}
+pub fn g4_stop() -> Vec<u128> {
+    g4_mark();
+    let times = G4_TIMES.with(|v| v.borrow_mut().take().unwrap());
+    assert_eq!(times.len(), 7);
+    times.windows(2).map(|t| (t[1] - t[0]).as_nanos()).collect()
+}
